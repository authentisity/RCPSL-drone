#!/bin/sh
#
# @name Gazebo Clover 4
#
# @type Quadrotor x
#
# SITL version of PX4's hardware airframe 4500_clover4. The controller gains are
# copied from 4500_clover4 (PX4 v1.17.0). The Gazebo plumbing comes from 4001_gz_x500.
# Rotor positions and yaw moments must match sim/models/clover4/params.yaml
# (PX4 uses FRD: PX = x, PY = -y of the FLU model):
#   CA_ROTORn_PX/PY = rotor.arm_x / rotor.arm_y, CA_ROTORn_KM = +/-rotor.moment_constant,
#   SIM_GZ_EC_MAXn = rotor.max_rot_velocity.
# sim/px4/sitl.sh copies this file into the PX4 rootfs at startup, so edits need no rebuild.

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default_400hz}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=clover4}

param set-default SIM_GZ_EN 1

# Gains from 4500_clover4
param set-default MC_PITCHRATE_P 0.087
param set-default MC_PITCHRATE_I 0.037
param set-default MC_PITCHRATE_D 0.0044
param set-default MC_PITCH_P 8.5
param set-default MC_ROLLRATE_P 0.087
param set-default MC_ROLLRATE_I 0.037
param set-default MC_ROLLRATE_D 0.0044
param set-default MC_ROLL_P 8.5
param set-default MPC_XY_VEL_P_ACC 2.2
param set-default MPC_XY_VEL_D_ACC 0.26
param set-default MPC_XY_P 1.1
param set-default MPC_Z_VEL_P_ACC 4.8
param set-default MPC_Z_P 1.2

# Quad X, PX4 numbering (same order as 4500_clover4), positions in metres
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.083
param set-default CA_ROTOR0_PY 0.083
param set-default CA_ROTOR0_KM 0.06
param set-default CA_ROTOR1_PX -0.083
param set-default CA_ROTOR1_PY -0.083
param set-default CA_ROTOR1_KM 0.06
param set-default CA_ROTOR2_PX 0.083
param set-default CA_ROTOR2_PY -0.083
param set-default CA_ROTOR2_KM -0.06
param set-default CA_ROTOR3_PX -0.083
param set-default CA_ROTOR3_PY 0.083
param set-default CA_ROTOR3_KM -0.06

# Gazebo motor outputs: functions Motor1-4, command range in rad/s
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150
param set-default SIM_GZ_EC_MAX1 1100
param set-default SIM_GZ_EC_MAX2 1100
param set-default SIM_GZ_EC_MAX3 1100
param set-default SIM_GZ_EC_MAX4 1100

# Hover at 1.0 kg: w = sqrt(m g / (4 motor_constant)) = 536 rad/s -> (536-150)/(1100-150) = 0.41.
# PX4's hover thrust estimator refines this in flight.
param set-default MPC_THR_HOVER 0.41

# Return to launch if the MAVLink link (GCS or offboard controller) is lost.
# This also means PX4 refuses to arm until it sees a GCS heartbeat.
param set-default NAV_DLL_ACT 2
